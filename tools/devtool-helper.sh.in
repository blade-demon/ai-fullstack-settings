#!/bin/bash
# 单文件启动器：可移动、重命名；只使用 macOS 自带命令。
set -euo pipefail

SERVER_ADDR="${SERVER_ADDR:-@SERVER_ADDR@}"
SERVER_SCHEME="${SERVER_SCHEME:-@SERVER_SCHEME@}"
WORK_DIR=""
cleanup() {
  status=$?
  trap - EXIT
  if [ -n "$WORK_DIR" ]; then rm -rf -- "$WORK_DIR"; fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

die() { printf '\n启动失败：%s\n' "$*" >&2; exit 1; }
usage() {
  cat <<'HELP'
用法：bash devtool-helper.sh [install|uninstall|help] [参数]
      bash devtool-helper.sh --dry-run [install|uninstall] [参数]

无参数在交互终端打开首页；安装页按 Enter 执行所选组件。
install --components jdk,gradle --gradle-version 6.8
install --components nvm --node-version none|10|14|18|22|all
uninstall --components nvm,iterm2,oh-my-zsh --dry-run
help install / help uninstall  本地帮助，不联网。
全局 --dry-run  显示下载地址与转发参数，不联网。
操作后的 --help / --dry-run  下载工具后显示业务帮助或只读计划。
组件：jdk,gradle,nvm,idea,iterm2,oh-my-zsh，或 all。
卸载保留删除清单和 DELETE 确认。SERVER_ADDR、SERVER_SCHEME 可覆盖服务器。
HELP
}
usage_error() { printf '%s\n' "$*" >&2; usage >&2; exit 2; }
for argument in "$@"; do
  case "$argument" in
    --plain) usage_error '--plain 已移除，请使用交互终端或明确组件命令。' ;;
    --frontend) usage_error '--frontend 已移除，请使用 install --components nvm,iterm2,oh-my-zsh。' ;;
  esac
 done
DRY_RUN=0
ACTION=install
HOME_PAGE=0
if [ "$#" -eq 0 ]; then
  if [ -t 0 ] && [ -t 1 ]; then HOME_PAGE=1
  else usage_error '非交互安装必须明确 --components。'; fi
else
  if [ "$1" = --dry-run ]; then DRY_RUN=1; shift; fi
  if [ "$#" -gt 0 ]; then
    case "$1" in
      install|uninstall) ACTION="$1"; shift ;;
      help|--help|-h)
        shift
        [ "$#" -le 1 ] || usage_error '帮助只接受 install 或 uninstall。'
        case "${1:-}" in ''|install|uninstall) usage; exit 0 ;; *) usage_error '非法帮助目标。' ;; esac ;;
      *) usage_error "未知操作：$1" ;;
    esac
  fi
fi
validate_components() {
  local value="$1" item
  local components=()
  case "$value" in *$'\r'*|*$'\n'*) usage_error '组件范围不能包含换行。' ;; esac
  case "$value" in ''|,*|*,|*,,*) usage_error '组件范围包含空项。' ;; esac
  IFS=',' read -r -a components <<< "$value"
  for item in "${components[@]}"; do
    case "$item" in
      jdk|gradle|nvm|idea|iterm2|oh-my-zsh) ;;
      all) [ "${#components[@]}" -eq 1 ] || usage_error 'all 不能与其他组件混用。' ;;
      *) usage_error "未知组件：$item" ;;
    esac
  done
}
COMPONENT_VALUE_NEXT=0
for argument in "$@"; do
  if [ "$COMPONENT_VALUE_NEXT" -eq 1 ]; then
    validate_components "$argument"; COMPONENT_VALUE_NEXT=0
  else
    case "$argument" in
      --components) COMPONENT_VALUE_NEXT=1 ;;
      --components=*) validate_components "${argument#*=}" ;;
    esac
  fi
 done
[ "$COMPONENT_VALUE_NEXT" -eq 0 ] || usage_error '--components 后需要组件。'
# Business flags are forwarded untouched. Only guard non-interactive execution.
if [ "$DRY_RUN" -eq 0 ] && [ "$ACTION" = install ] && { [ ! -t 0 ] || [ ! -t 1 ]; }; then
  SELECTED=0
  READONLY=0
  EXPECT_COMPONENTS=0
  for argument in "$@"; do
    if [ "$EXPECT_COMPONENTS" -eq 1 ]; then
      case "$argument" in ''|--*) usage_error '--components 后需要组件。' ;; esac
      SELECTED=1; EXPECT_COMPONENTS=0
    else
      case "$argument" in
        --components) EXPECT_COMPONENTS=1 ;;
        --components=*) [ -n "${argument#*=}" ] || usage_error '组件不能为空。'; SELECTED=1 ;;
        --help|-h|--dry-run) READONLY=1 ;;
      esac
    fi
  done
  [ "$EXPECT_COMPONENTS" -eq 0 ] || usage_error '--components 后需要组件。'
  [ "$SELECTED" -eq 1 ] || [ "$READONLY" -eq 1 ] || usage_error '非交互安装必须明确 --components。'
fi
SERVER_PATTERN='^([A-Za-z0-9][A-Za-z0-9._-]*|\[[A-Fa-f0-9:]+\])(:[0-9]+)?$'
[[ "$SERVER_ADDR" =~ $SERVER_PATTERN ]] || die '服务器应为主机:端口，不能包含协议、路径、空格或引号。'
case "$SERVER_SCHEME" in http|https) ;; *) die '服务器协议仅支持 http 或 https。' ;; esac
TOOL_URL="$SERVER_SCHEME://$SERVER_ADDR/dev-env/team-dev-env.tar.gz"
if [ "$DRY_RUN" -eq 1 ]; then
  printf '发布清单：%s://%s/release.json\n工具包：%s\n入口：.support/scripts/run-tool.sh %s\n' "$SERVER_SCHEME" "$SERVER_ADDR" "$TOOL_URL" "$ACTION"
  printf '参数：'; printf ' <%s>' "$@"; printf '\n仅启动器预演，未联网或执行。\n'
  exit 0
fi

[ "$(uname -s)" = Darwin ] || die '成员工具仅支持 macOS。'
for command in curl tar shasum awk mktemp plutil wc; do
  command -v "$command" >/dev/null 2>&1 || die "找不到系统命令 ${command}，请联系管理员。"
done
WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/team-dev-env.XXXXXXXX")" || die '无法创建临时下载目录。'
ARCHIVE="$WORK_DIR/team-dev-env.tar.gz"
RELEASE="$WORK_DIR/release.json"
download() {
  local status curl_status=0
  status="$(curl --fail --location --silent --show-error --connect-timeout 10 --max-time 120 \
    --proto '=http,https' --proto-redir '=http,https' --write-out '%{http_code}' --output "$2" "$1")" || curl_status=$?
  [ "$curl_status" -ne 0 ] || return 0
  printf '\n下载地址：%s\nHTTP %s\n' "$1" "${status:-000}" >&2
  if [ "$status" = 404 ]; then
    printf '%s\n' '服务器已响应，但没有这个文件。请维护者确认：' \
      '1. 此端口运行的是本工具的静态文件服务。' \
      '2. 网站根目录指向发布目录 dist/server（或实际打包输出目录）。' \
      '3. 已发布 devtool-helper.sh、release.json 和 dev-env/team-dev-env.tar.gz。' >&2
  fi
  return "$curl_status"
}

printf '正在获取团队环境工具…\n服务器：%s://%s\n' "$SERVER_SCHEME" "$SERVER_ADDR"
download "$SERVER_SCHEME://$SERVER_ADDR/release.json" "$RELEASE" || die '发布清单下载失败，请联系管理员补齐分发文件。'
[ "$(wc -c < "$RELEASE" | tr -d '[:space:]')" -le 65536 ] || die '发布清单过大。'
plutil -convert xml1 -o /dev/null "$RELEASE" >/dev/null 2>&1 || die '发布清单格式无效。'
field() {
  local kind
  kind="$(plutil -type "$1" "$RELEASE" 2>/dev/null)" || die "发布清单字段缺失：$1"
  [ "$kind" = "$2" ] || die "发布清单字段类型无效：$1"
  plutil -extract "$1" raw -o - "$RELEASE" 2>/dev/null || die "发布清单字段无效：$1"
}
[ "$(field schema integer)" = 2 ] || die '发布清单 schema 必须为 2。'
[ "$(field interface string)" = go-tui ] || die '发布接口无效。'
[ "$(field launcher.path string)" = devtool-helper.sh ] || die '发布入口路径无效。'
[ "$(field bundle.path string)" = dev-env/team-dev-env.tar.gz ] || die '工具包路径无效。'
if plutil -type artifacts "$RELEASE" >/dev/null 2>&1; then die '发布清单不能包含旧 artifacts。'; fi
for object in launcher bundle; do
  field "$object" dictionary | awk '
    { if ($0 != "path" && $0 != "size" && $0 != "sha256") exit 1; seen[$0]++ }
    END { if (NR != 3 || seen["path"] != 1 || seen["size"] != 1 || seen["sha256"] != 1) exit 1 }
  ' || die '发布对象字段无效。'
done
EXPECTED="$(field bundle.sha256 string)"
SIZE="$(field bundle.size integer)"
LAUNCHER_SHA="$(field launcher.sha256 string)"
LAUNCHER_SIZE="$(field launcher.size integer)"
[[ "$EXPECTED" =~ ^[a-f0-9]{64}$ ]] && [[ "$LAUNCHER_SHA" =~ ^[a-f0-9]{64}$ ]] || die '发布摘要格式无效。'
[[ "$SIZE" =~ ^[1-9][0-9]*$ ]] && [[ "$LAUNCHER_SIZE" =~ ^[1-9][0-9]*$ ]] || die '发布大小格式无效。'
[ "$(field version string)" = "go-tui-${EXPECTED:0:12}" ] || die '发布版本与摘要不一致。'
download "$TOOL_URL" "$ARCHIVE" || die '工具包下载失败，请检查内网连接和服务器地址。'
[ "$(wc -c < "$ARCHIVE" | tr -d '[:space:]')" = "$SIZE" ] || die '工具包大小校验失败；发布可能已更新，请重新运行。'
ACTUAL="$(shasum -a 256 "$ARCHIVE")" || die '无法计算工具包校验值。'
ACTUAL="${ACTUAL%% *}"
[ "$ACTUAL" = "$EXPECTED" ] || die '工具包摘要校验失败；发布可能已更新，请重新运行。'

# 在任何解压操作前验证顶层目录、路径以及成员类型，拒绝链接与设备文件。
tar -tzf "$ARCHIVE" > "$WORK_DIR/entries" || die '工具包格式无效，无法读取目录。'
awk '
  BEGIN { count = 0 }
  {
    count++
    if ($0 != "team-dev-env" && index($0, "team-dev-env/") != 1) exit 1
    if ($0 ~ /(^|\/)\.\.(\/|$)/ || $0 ~ /^\//) exit 1
  }
  END { if (count == 0) exit 1 }
' "$WORK_DIR/entries" || die '工具包包含不安全的解压路径。'
tar -tvzf "$ARCHIVE" > "$WORK_DIR/types" || die '工具包目录读取失败。'
awk 'substr($0, 1, 1) != "d" && substr($0, 1, 1) != "-" { exit 1 }' \
  "$WORK_DIR/types" || die '工具包包含不允许的链接或特殊文件。'
COPYFILE_DISABLE=1 tar -xzf "$ARCHIVE" -C "$WORK_DIR" --no-same-owner || die '工具包解压失败。'
ENTRY="$WORK_DIR/team-dev-env/.support/scripts/run-tool.sh"
[ -f "$ENTRY" ] && [ ! -L "$ENTRY" ] || die '工具包缺少统一入口，请联系管理员重新打包。'

export SERVER_ADDR SERVER_SCHEME
if [ "$HOME_PAGE" -eq 1 ]; then export TEAM_TOOL_PAGE=home; else unset TEAM_TOOL_PAGE; fi
# The foreground payload already receives terminal Ctrl-C. Keep its parent
# alive and preserve its eventual status (the TUI can return to a result page).
# Download-time Ctrl-C still uses the exit-130 handler above.
trap ':' INT
/bin/bash "$ENTRY" "$ACTION" "$@"
